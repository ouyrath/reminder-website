{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "test-five-min.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/test-5-min", "dest": "/test-five-min.js" },
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "crons": [
    { "path": "/api/send-reminders", "schedule": "0 13 * * *" }
  ]
}
