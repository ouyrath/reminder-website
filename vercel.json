{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "test-five-min.js",
      "use": "@vercel/node"
    },
    {
      "src": "my-reminders.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Strict-Transport-Security": "max-age=31536000",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/test-5-min",
      "dest": "/test-five-min.js"
    },
    {
      "src": "/my-reminders",
      "dest": "/my-reminders.js"
    },
    {
      "src": "/api/my-reminders/request-access",
      "dest": "/my-reminders.js"
    },
    {
      "src": "/api/my-reminders/attachment-url",
      "dest": "/my-reminders.js"
    },
    {
      "src": "/api/my-reminders/delete-attachment",
      "dest": "/my-reminders.js"
    },
    {
      "src": "/api/push/status",
      "dest": "/my-reminders.js"
    },
    {
      "src": "/api/push/config",
      "dest": "/my-reminders.js"
    },
    {
      "src": "/api/push/subscribe",
      "dest": "/my-reminders.js"
    },
    {
      "src": "/api/push/unsubscribe",
      "dest": "/my-reminders.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
